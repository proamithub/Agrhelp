@model StudentMasterDTO
@{
    var we = "";
    var imgurl = Model.ImageURL + Model.MPATH;

}
<div style="">
    <div class="mt-2">
        <center>
            <a href="javascript:void(0)" onclick="return PrintPanel('prnttb')" class="btn btn-primary btn-md text-white "><i class="fa fa-print"></i> Print</a>
            <a href="/" class="btn btn-warning btn-md text-white "><i class="fa fa-arrow-left"></i> Back</a>
            @* <a asp-action="ResultDownload_t1" asp-controller="Home" asp-route-data="@Model.EncrptedRoll" class="btn btn-primary btn-sm text-white "> Download</a> *@
        </center>

    </div>
    <div id="Cpytxt">
        <div class="page " style="   width: 21cm;
    min-height: 29.7cm;
    padding: 1cm;
    margin: 10px auto;
    border: 1px #D3D3D3 solid;
    border-radius: 5px;
    background: white;
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);">
            <div class="subpage" style=" color: #000; font-family: Arial; font-size: 14px">
                <div id="prnttb">
                    <table style="width: 100% ;  border-collapse: collapse;" class="table ">

                        <tr style="padding:0px;border: 1px solid #000 !important;">

                            <td style="padding:0px;border: 1px solid #000 !important;">
                                <table style="width: 100%;border:none !important">
                                    <tr style="padding:0px;">
                                        <td style="width:2%;vertical-align:top;text-align:center; padding:5px;margin-left:1px;  border:none !important">


                                            @{

                                                // var p = "/logo_header.png";
                                                var p = "https://admission.agrauniv.online/logo_header.png";
                                            }
                                            <img src="@p" style="width: 75px; height: 75px;margin-top:2px" alt="" />
                                        </td>
                                        <td style="width:75%;text-align:center;vertical-align:top;padding:5px;margin-left:1px; line-height:25px;font-weight:bold;font-size:16px; border:none !important">
                                            DR. BHIMRAO AMBEDKAR UNIVERSITY, AGRA <br />
                                            @Model.HELD_IN<br />
                                            STATEMENT OF MARKS <br />

                                        </td>
                                        <td style="float:right;font-weight:bold;font-size:12px ;border:none !important">
                                            <img src="@String.Format("data:image/png;base64,{0}",
                                Convert.ToBase64String(Model.qcore))" height="80" width="100" />


                                        </td>
                                    </tr>


                                </table>

                            </td>
                        </tr>
                        <tr style="padding:0px;border-left: 1px solid #000 !important;border-right: 1px solid #000 !important;">

                            <td style="border-bottom:none !important; padding:0px">
                                <div class="watermark" style="position: absolute;font-size: 3em;
        width: 550px;
        height: 550px;
        left: 500px;
        top: 25%;
text-align:center;
        background-repeat: no-repeat;
        background-image: url('http://result.agrauniv.online/image/DHRAU_Watermark.png');
        z-index: 9999;
        opacity: 0.075;"></div>
                                <table style="width: 100%;  border-collapse: collapse;">
                                    <tbody>
                                        <tr style="padding:0px;">
                                            <th style="border:none !important ;width:20%;vertical-align:top;text-align:left; font-size: 13px ; padding:5px"> COURSE NAME </th>
                                            <td colspan="3" style="border:none !important ;width:60%;vertical-align:top;padding:5px;text-transform:uppercase">
                                                : <strong>@Model.DisplayCourseName</strong>
                                            </td>
                                        </tr>

                                        <tr style="padding:0px">

                                            @* <th style="border:none !important ;width:20%;vertical-align:top;text-align:left; font-size: 13px ; padding:5px">SEMESTER</th>
                                            <td colspan="2" style="border:none !important ;width:60%;vertical-align:top;padding:5px;text-transform:uppercase">
                                            : @Model.DisplaySemester
                                            </td> *@
                                            <th style="border:none !important ;width:20%;vertical-align:top;text-align:left; font-size: 13px ; padding:5px">ROLL NO </th>

                                            <td colspan="2" style="border:none !important ;width:60%;vertical-align:top;padding:5px;text-transform:uppercase">
                                                :<strong> @Model.ROLL_NO</strong>
                                            </td>

                                            <td rowspan="5" style="border:none !important" width="110" height="150">
                                                <center>
                                                    <div style="font-weight:700 ;font-size:10px">
                                                        <b>  CATEGORY :</b>
                                                        <b> @Model.EXAM_TYPE</b>
                                                    </div>
                                                    @{
                                                        var img = Model.ImageURL + Model.MPATH;
                                                    }
                                                    <img style="border:1px solid #000" id="Image1" src="@img" alt="" width="110" height="140" />
                                                </center>

                                            </td>
                                        </tr>
                                        @*   <tr>

                                        <th style="border:none !important ;width:20%;vertical-align:top;text-align:left; font-size: 13px ; padding:5px">ROLL NO </th>

                                        <td colspan="2" style="border:none !important ;width:60%;vertical-align:top;padding:5px;text-transform:uppercase">
                                        :<strong> @Model.ROLL_NO</strong>
                                        </td>
                                        </tr> *@
                                        <tr>
                                            <th style="border:none !important ;width:20%;vertical-align:top;text-align:left; font-size: 13px ; padding:5px"> ENROLLMENT No</th>
                                            <td colspan="2" style="border:none !important ;width:60%;vertical-align:top;padding:5px;text-transform:uppercase">
                                                : @Model.ENROLLMENT_NO
                                            </td>
                                        </tr>

                                        <tr>
                                            <th style="border:none !important ;width:20%;vertical-align:top;text-align:left; font-size: 13px ; padding:5px"> STUDENT'S NAME</th>
                                            <td colspan="2" style="border:none !important ;width:60%;vertical-align:top;padding:5px;text-transform:uppercase">
                                                : <strong>@Model.NAME</strong>
                                            </td>
                                        </tr>

                                        <tr>
                                            <th style="border:none !important ;width:20%;vertical-align:top;text-align:left; font-size: 13px ; padding:5px"> FATHER'S NAME</th>
                                            <td colspan="2" style="border:none !important ;width:60%;vertical-align:top;padding:5px;text-transform:uppercase">
                                                : @Model.FNAME
                                            </td>
                                        </tr>
                                        <tr>

                                            <th style="border:none !important ;width:20%;vertical-align:top;text-align:left; font-size: 13px ; padding:5px"> MOTHER'S NAME</th>
                                            <td colspan="2" style="border:none !important ;width:60%;vertical-align:top;padding:5px;text-transform:uppercase">
                                                : @Model.MNAME
                                            </td>
                                        </tr>


                                        <tr>

                                            <th style="border:none !important ;width:20%;vertical-align:top;text-align:left; font-size: 13px ; padding:5px"> COLLEGE NAME</th>
                                            <td colspan="3" style="border:none !important ;width:60%;vertical-align:top;padding:5px;text-transform:uppercase">
                                                : <strong>(@Model.CCODE) - @Model.CNAME</strong>
                                            </td>
                                        </tr>


                                    </tbody>
                                </table>
                            </td>
                        </tr>
                        <tr style="text-align:center ;border-collapse: collapse;border-left: 1px solid #000 !important;">

                            <td style="padding:0px !important ;border:none !important">
                                <table style="width: 100%;  border-collapse: collapse;">

                                    <tr style="font-size:12px;">
                                        <th colspan="2" style="vertical-align:middle;border-right: 1px solid #000 !important;border-top: 1px solid #000 !important;border-bottom: 1px solid #000 !important;width:100%;text-align:left; padding:5px;margin-left:1px;">
                                            <center> <strong>Subject</strong></center>
                                        </th>
                                        <th colspan="3" style="border: 1px solid #000 !important;width:30%;vertical-align:middle; padding:5px;margin-left:1px;"><strong>Maximum Marks </strong> </th>
                                        <th colspan="3" style="border: 1px solid #000 !important;width:30%;vertical-align:middle; padding:5px;margin-left:1px;"><strong>Minimum Marks </strong></th>
                                        <th colspan="3" style="border: 1px solid #000 !important;width:10%;vertical-align:middle; padding:5px;margin-left:1px;"><strong>Marks Obtained</strong></th>


                                    </tr>
                                    <tr style="font-size:12px;">
                                        <th style="border-right: 1px solid #000 !important;border-top: 1px solid #000 !important;border-bottom: 1px solid #000 !important;text-align:left;vertical-align:top; padding:5px;margin-left:1px;">
                                            <strong>Code</strong>
                                        </th>
                                        <th style="border: 1px solid #000 !important;width:30%;vertical-align:top; padding:5px;margin-left:1px;width:100%"><strong>Name </strong> </th>


                                        <th style="border: 1px solid #000 !important;width:30%;vertical-align:top; padding:5px;margin-left:1px;"><strong>Th. </strong></th>
                                        <th style="border: 1px solid #000 !important;width:10%;vertical-align:top; padding:5px;margin-left:1px;"><strong>Int.</strong></th>
                                        <th style="border: 1px solid #000 !important;width:10%;vertical-align:top; padding:5px;margin-left:1px;"><strong>Total</strong></th>

                                        <th style="border: 1px solid #000 !important;width:30%;vertical-align:top; padding:5px;margin-left:1px;"><strong>Th. </strong></th>
                                        <th style="border: 1px solid #000 !important;width:10%;vertical-align:top; padding:5px;margin-left:1px;"><strong>Int.</strong></th>
                                        <th style="border: 1px solid #000 !important;width:10%;vertical-align:top; padding:5px;margin-left:1px;"><strong>Total</strong></th>

                                        <th style="border: 1px solid #000 !important;width:30%;vertical-align:top; padding:5px;margin-left:1px;"><strong>Th. </strong></th>
                                        <th style="border: 1px solid #000 !important;width:10%;vertical-align:top; padding:5px;margin-left:1px;"><strong>Int.</strong></th>
                                        <th style="border: 1px solid #000 !important;width:10%;vertical-align:top; padding:5px;margin-left:1px;"><strong>Total</strong></th>

                                    </tr>

                                    @if (Model.MarksList.Count > 0)
                                    {
                                        foreach (var item in Model.CSPList.OrderBy(x => x.PCODE_N))
                                        {
                                            var PCODE_N = Model.CSPList.Where(x => x.PCODE == item.PCODE).Select(x => x.PCODE_N).FirstOrDefault();

                                            if (Model.MarksList.Where(x => x.PCODE == item.PCODE_N && x.SUBJECT_NAME == item.PNAME_R).FirstOrDefault() != null)
                                            {


                                                <tr style="font-size:12px;border-right: 1px solid #000 !important;border-top: 1px solid #000 !important;border-bottom: 1px solid #000 !important;">
                                                    <td width="25%" style="text-align:left;font-weight:bold;border-right: 1px solid #000 !important;border-top: 1px solid #000 !important;border-bottom: 1px solid #000 !important">
                                                        @if (!string.IsNullOrEmpty(PCODE_N))
                                                        {
                                                            <span> @PCODE_N </span>
                                                        }
                                                    </td>

                                                    <td width="100%" style="text-align:left; border: 1px solid #000 !important;">
                                                        <strong> @item.PNAME_R</strong>
                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        <center> @item.THEORY_MAX</center>

                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        <center> @item.INTERNAL_MAX</center>
                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        <center> @item.MAX_INT_EXT_TOT</center>
                                                    </td>

                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        <center>@item.THEORY_MIN</center>
                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        <center> @item.INTERNAL_MIN</center>
                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        <center>  @item.MIN_INT_EXT_TOT</center>
                                                    </td>

                                                    <td width="7%" style="border: 1px solid #000 !important;">
                                                        @{
                                                            var MARKS_OBT = Model.MarksList.Where(x => x.PCODE == item.PCODE_N && x.SUBJECT_NAME == item.PNAME_R).Select(x => x.MARKS_OBT).FirstOrDefault();
                                                            var MARKS_OBTstat = Model.MarksList.Where(x => x.PCODE == item.PCODE_N && x.SUBJECT_NAME == item.PNAME_R && x.IsStarTh == true).Select(x => x.IsStarTh).FirstOrDefault();
                                                        }
                                                        <center>
                                                            @if (MARKS_OBTstat != null)
                                                            {
                                                                <span>@MARKS_OBT*</span>
                                                            }
                                                            else
                                                            {
                                                                <span>@MARKS_OBT</span>
                                                            }

                                                        </center>
                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        @{
                                                            var INT_OBT = Model.MarksList.Where(x => x.PCODE == item.PCODE_N && x.SUBJECT_NAME == item.PNAME_R).Select(x => x.INT_OBT).FirstOrDefault();
                                                            var INT_OBTstat = Model.MarksList.Where(x => x.PCODE == item.PCODE_N && x.SUBJECT_NAME == item.PNAME_R && x.IsStarInt == true).Select(x => x.IsStarInt).FirstOrDefault();
                                                        }
                                                        <center>
                                                            @if (INT_OBTstat != null)
                                                            {
                                                                <span>@INT_OBT*</span>
                                                            }
                                                            else
                                                            {
                                                                <span>@INT_OBT</span>
                                                            }
                                                        </center>
                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        @{
                                                            var PAPER_TOT_MARKS_OBT = Model.MarksList.Where(x => x.PCODE == item.PCODE_N && x.SUBJECT_NAME == item.PNAME_R).Select(x => x.PAPER_TOT_MARKS_OBT).FirstOrDefault();
                                                        }
                                                        <center>@PAPER_TOT_MARKS_OBT</center>
                                                    </td>



                                                </tr>
                                            }
                                        }
                                    }

                                    <tr style="text-align:center; font-size:12px;border-right: 1px solid #000 !important;border-top: 1px solid #000 !important;border-bottom: 1px solid #000 !important;font-weight:bold">
                                        <td></td>
                                        <td style="text-align:left;font-weight:bold;border-right: 1px solid #000 !important;border-top: 1px solid #000 !important;border-bottom: 1px solid #000 !important;padding:5px">
                                            <strong>   Total</strong>
                                        </td>
                                        <td width="5%" style="border: 1px solid #000 !important;">
                                        </td>
                                        <td width="5%" style="border: 1px solid #000 !important;">
                                        </td>
                                        <td width="5%" style="border: 1px solid #000 !important;">
                                            <strong> @Model.ResultList.Take(1).Select(x=>x.MAX_MARKS).FirstOrDefault()</strong>
                                        </td>
                                        <td width="5%" style="border: 1px solid #000 !important;">
                                        </td>
                                        <td width="5%" style="border: 1px solid #000 !important;">
                                        </td>
                                        <td width="5%" style="border: 1px solid #000 !important;">
                                            <strong> @Model.ResultList.Take(1).Select(x=>x.MIN_MARKS).FirstOrDefault() </strong>
                                        </td>
                                        <td width="5%" style="border: 1px solid #000 !important;">
                                        </td>
                                        <td width="5%" style="border: 1px solid #000 !important;">
                                        </td>
                                        <td width="5%" style="border: 1px solid #000 !important;">
                                            <strong> @Model.ResultList.Take(1).Select(x=>x.MARKS_OBT).FirstOrDefault() </strong>
                                        </td>
                                    </tr>

                                </table>
                            </td>
                        </tr>

                        <tr style="font-size:12px">
                            <td style="border-top:none !important;border-left: 1px solid #000 !important;border-right: 1px solid #000 !important;border-bottom: 1px solid #000 !important;">
                                <table style="width: 100%;border:none !important;">
                                    <tr>
                                        <td style="border:none !important ;text-align:left">
                                            <div style="font-size:10px;margin-bottom:5px">
                                                (Passing Marks is 45% of Aggregate)
                                            </div>
                                            <p style="padding:0px;margin:0px">
                                                RESULT :

                                                <strong>
                                                    @if (Model.ResultList.Select(x => x.RESULT).FirstOrDefault() != null)
                                                    {
                                                        @Model.ResultList.Select(x => x.RESULT).FirstOrDefault()
                                                    }
                                                    else
                                                    {

                                                    }
                                                </strong>
                                            </p>
                                            <p style="padding:0px;margin:0px">
                                                DATE OF RESULT DECLARATION : <strong>@Model.ResultList.Select(x=>x.RESULT_DECL_DATE).FirstOrDefault()</strong>

                                            </p>
                                            <p style="padding:0px;margin:0px">

                                                <strong>  @Model.STD_Remarks</strong>
                                            </p>
                                        </td>

                                    </tr>
                                </table>
                                <hr style="margin:0px" />
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="border:none !important ;text-align:left">
                                            <p style="padding:0px;margin:0px">
                                                1. This statement is a computer generated document and no need of manual signature.
                                            </p>
                                            <p style="padding:0px;margin:0px">
                                                2. In case of any discrepancy University record shall be final.
                                            </p>
                                        </td>
                                    </tr>

                                </table>
                                <div style="text-align:center;float:right">
                                    <img src="https://resulttest.agrauniv.online/sign.jpeg" height="50" width="100" /><br />
                                    Controller of Examinations
                                </div>
                            </td>
                        </tr>
                    </table>


                </div>
            </div>
        </div>




    </div>
</div>