                                                    <div style="font-weight:700 ;font-size:10px">
                                                        <b>  CATEGORY :</b>
                                                        <b> @Model.EXAM_TYPE</b>
                                                    </div>
                                                    @{
                                                        var img = Model.ImageURL + Model.MPATH;
                                                    }
