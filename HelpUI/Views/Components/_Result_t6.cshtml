                                                        } <center>  @MaxExtp</center>
                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        @{
                                                            var MinExtp = Model.CSPList.Where(x => x.SUBJECT_NAME == s.SUBJECT_NAME && x.PTYPE == "P").Select(x => x.THEORY_MIN).Sum().ToString();
                                                        } <center>  @MinExtp</center>

                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        @{
                                                            var cv = Model.CSPList.Where(x => x.SUBJECT_NAME == s.SUBJECT_NAME && x.PTYPE == "P").Select(x => x.PCODE).ToList();
                                                            int obtp = 0;
                                                            foreach (var pi in cv)
                                                            {
                                                                obtp = Convert.ToInt32(Model.MarksList.Where(x => x.PCODE == pi.ToString()).Select(x => x.MARKS_OBT).FirstOrDefault());

                                                            }

                                                        } <center>  @obtp</center>

                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">


                                                        <center>
                                                            @{
                                                                var ds = obtTot1 + obtp;

                                                            } @ds
                                                        </center>
                                                    </td>

                                                </tr>

                                            }
                                        }
                                    }

