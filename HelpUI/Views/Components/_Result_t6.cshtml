                                                            if (cvT != null)
                                                            {
                                                                int obtT1 = 0;
                                                                obtT1 = Convert.ToInt32(Model.MarksList.Where(x => x.PCODE == cvT.ToString()).Select(x => x.MARKS_OBT).FirstOrDefault());
                                                                <center>  @obtT1</center>
                                                            }
                                                        }
                                                    </td>

                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        @{
                                                            var cvT2 = Model.CSPList.Where(x => x.SUBJECT_NAME == s.SUBJECT_NAME && x.PTYPE == "T" && x.PNAME == "Paper II").Take(1).Select(x => x.PCODE).FirstOrDefault();
                                                            if (cvT2 != null)
                                                            {
                                                                int obtT2 = 0;
                                                                obtT2 = Convert.ToInt32(Model.MarksList.Where(x => x.PCODE == cvT2.ToString()).Select(x => x.MARKS_OBT).FirstOrDefault());
                                                                <center>  @obtT2</center>
                                                            }
                                                        }

                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        @{
                                                            var cvT3 = Model.CSPList.Where(x => x.SUBJECT_NAME == s.SUBJECT_NAME && x.PTYPE == "T" && x.PNAME == "Paper III").Take(1).Select(x => x.PCODE).FirstOrDefault();
                                                            if (cvT3 != null)
                                                            {
                                                                int obtT3 = 0;
                                                                obtT3 = Convert.ToInt32(Model.MarksList.Where(x => x.PCODE == cvT3.ToString()).Select(x => x.MARKS_OBT).FirstOrDefault());
                                                                <center>  @obtT3</center>
                                                            }
                                                        }


                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        @{
                                                            var cvT4 = Model.CSPList.Where(x => x.SUBJECT_NAME == s.SUBJECT_NAME && x.PTYPE == "T" && x.PNAME == "Paper IV").Take(1).Select(x => x.PCODE).FirstOrDefault();


                                                            if (cvT4 != null)
                                                            {
                                                                int obtT4 = 0;
                                                                obtT4 = Convert.ToInt32(Model.MarksList.Where(x => x.PCODE == cvT4.ToString()).Select(x => x.MARKS_OBT).FirstOrDefault());
                                                                <center>  @obtT4</center>
                                                            }
                                                        }


                                                    </td>
                                                    <td width="5%" style="border: 1px solid #000 !important;">
                                                        @{
                                                            var cvTot = Model.CSPList.Where(x => x.SUBJECT_NAME == s.SUBJECT_NAME && x.PTYPE == "T").Select(x => x.PCODE).ToList();
                                                            int obtTot1 = 0;
                                                            foreach (var pi in cvTot)
