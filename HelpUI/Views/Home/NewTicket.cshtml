<script>

    document.getElementById("captcha").addEventListener("keydown", function (e) {
        if (!e) { var e = window.event; }
        //e.preventDefault(); // sometimes useful

        // Enter is pressed
        if (e.keyCode == 13) { NewSave(); }
    }, false);

       // ----------------------------
         var dt = new DataTransfer();

      $("#attachment").on("change", function () {

          var input = this;
          var selectedFiles = Array.from(input.files);

          selectedFiles.forEach(function (file) {

              var fileName = file.name;
              var fileSize = file.size;
              var fileExt = fileName.split(".").pop().toLowerCase();

              var allowedExt = ["jpg", "jpeg", "png", "pdf"];
              var maxSize = 1 * 1024 * 1024; // 1 MB

              // Extension validation
              if ($.inArray(fileExt, allowedExt) === -1) {
                  alert("File (" + fileName + ") type is not allowed.");
                  return; // IMPORTANT - don't add
              }

              // Size validation
              if (fileSize > maxSize) {
                  alert("File (" + fileName + ") size is too big. Max 1 MB.");
                  return; // IMPORTANT - don't add
              }

              // Duplicate check
              var alreadyExists = false;

              for (var j = 0; j < dt.files.length; j++) {
                  if (
                      dt.files[j].name === file.name &&
                      dt.files[j].size === file.size
                  ) {
                      alreadyExists = true;
                      break;
                  }
              }

              if (alreadyExists) {
                  alert("File (" + fileName + ") already selected.");
                  return;
              }

              // Add ONLY valid file
              dt.items.add(file);

              // Display file
              var fileBloc = $("<span/>", {
                  class: "file-block"
              });

              var fileNameSpan = $("<span/>", {
                  class: "name",
                  text: fileName
              });

              fileBloc
                  .append('<span class="file-delete"><span>+</span></span>')
                  .append(fileNameSpan);

              $("#filesList > #files-names").append(fileBloc);
          });

          // VERY IMPORTANT
          // Replace input files with ONLY valid files
          input.files = dt.files;
      });


      // Remove file
      $(document).on("click", ".file-delete", function () {

          var fileBlock = $(this).closest(".file-block");
          var fileName = fileBlock.find(".name").text();

          // Remove UI
          fileBlock.remove();

          // Remove from DataTransfer
          for (var i = 0; i < dt.items.length; i++) {

              var file = dt.items[i].getAsFile();

              if (file && file.name === fileName) {
                  dt.items.remove(i);
                  break;
              }
          }

          // Update actual input
          document.getElementById("attachment").files = dt.files;
      });
    // ----------------------------

    function showprofile() {

        var fuData = document.getElementById('ProfilePic');
        var FileUploadPath = fuData.value;


        if (FileUploadPath == '') {
            alert("Please upload an image");

        } else {
            var Extension = FileUploadPath.substring(FileUploadPath.lastIndexOf('.') + 1).toLowerCase();
            if (Extension == "gif" || Extension == "png" || Extension == "jpeg" || Extension == "jpg" || Extension == "PNG" || Extension == "JPEG" || Extension == "JPG") {
                var reader = new FileReader();

                if (typeof (fuData.files) != "undefined") {
                    var size = parseFloat(fuData.files[0].size / 1024).toFixed(2);
                    if (size > 100) {
                        alert("Image size should not more than 100kb. ");
                        document.getElementById("ProfilePic").value = null;
                    }
                    else {
                        reader.onload = function (e) {
                            $('#ProfileImg').attr('src', e.target.result);
                        }

                        reader.readAsDataURL(fuData.files[0]);
                    }
                } else {
                    alert("This browser does not support HTML5.");
                }


            }


            else {
                alert("Photo only allows file types of GIF, PNG, JPG and JPEG. ");
            }
        }
    }
</script>
