<script>
    function validEmail(email) {
        const re = /^(([^<>()[\]\\.,;:\s@@"]+(\.[^<>()[\]\\.,;:\s@@"]+)*)|(".+"))@@((\[[0-9]{1, 3}\.[0-9]{1, 3}\.[0-9]{1, 3}\.[0-9]{1, 3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        return re.test(String(email).toLowerCase());
    }
    function validEnroll(Enroll) {
        const re = /^([a-zA-Z0-9,:\S/-]*)$/;
        return re.test(String(Enroll).toLowerCase());
    }


    function NewSave() {
        flag = true;

        if ($('#CTypeID option:selected').text() != 'IGRS' && $('#CTypeID option:selected').text() != 'TN-No' && $('#CTypeID option:selected').text() != 'RTI') {
            if ($.trim($("#Subject").val()) == "") {
                $("#Subject").addClass("input-validation-error");
                flag = false;
            }
            else {
                $("#Subject").removeClass("input-validation-error");
            }
        } if ($.trim($("#Enroll_Roll").val()) == "") {
            $("#Enroll_Roll").addClass("input-validation-error");
            flag = false;
        }
        else {
            $("#Enroll_Roll").removeClass("input-validation-error");
        }
        // if ($.trim($("#Enroll_Roll").val()) != "") {
        //     var enroll = $.trim($("#Enroll_Roll").val());

        //     if (!validEnroll(enroll)) {
        //         alert("d")
        //         $("#Enroll_Roll").addClass("input-validation-error");
        //         flag = false;
        //     }
        //     else {
        //         $("#Enroll_Roll").removeClass("input-validation-error");
        //     }
        // }

        if ($('#CTypeID option:selected').text() != 'IGRS' && $('#CTypeID option:selected').text() != 'TN-No' && $('#CTypeID option:selected').text() != 'RTI') {
            if ($.trim($("#Name").val()) == "") {
                $("#Name").addClass("input-validation-error");
                flag = false;
            }
            else {
                $("#Name").removeClass("input-validation-error");
            }


            // if ($.trim($("#Email").val()) == "") {
            //     $("#Email").addClass("input-validation-error");
            //     flag = false;
            // }
            // else {
            //     $("#Email").removeClass("input-validation-error");
            // }

            if ($.trim($("#Email").val()) != "") {
                var email = $.trim($("#Email").val());
                if (!validEmail(email)) {
                    $("#Email").addClass("input-validation-error");
                    flag = false;
                }
                else {
                    $("#Email").removeClass("input-validation-error");
                }
            }
            if ($.trim($("#Mobile").val()) == "") {
                $("#Mobile").addClass("input-validation-error");
                flag = false;
            }
            else {
                var number = $.trim($("#Mobile").val());
                if (number.match(/^[6-9][0-9]{9}$/)) {
                    $("#Mobile").removeClass("input-validation-error");
                }
                else {
                    flag = false;
                    if (!$("#Mobile").hasClass("input-validation-error"))
                        $("#Mobile").addClass("input-validation-error");
                }
            }
        }
        if ($('#CTypeID option:selected').text() == 'Computerized/Duplicate Marksheet') {
            if ($.trim($("#ApplicationNo").val()) == "") {
                $("#ApplicationNo").addClass("input-validation-error");
                flag = false;
            }
            else {
                $("#ApplicationNo").removeClass("input-validation-error");
            }
        }

        if ($('#ProfilePic').length) {
            var fuData = document.getElementById('ProfilePic');

            var FileUploadPath = fuData.value;
            if (FileUploadPath == '') {
                $("#ProfilePic").addClass("input-validation-error");
                flag = false;
            } else {
                $("#ProfilePic").removeClass("input-validation-error");
            }
        }
        const ans = captcha.valid($('input[name="code"]').val());
        if (ans == false) {
            flag = false;
            $("#captcha").addClass("input-validation-error");
        } else {
            $("#captcha").removeClass("input-validation-error");
        }
        if (flag) {

            $("#help").submit();
        }
    }


</script>
<script>

    $('#btnser').show();
    $('#btnserwait').hide();

    $(function () {
        ChangeForIgrs();
    });

    function SearchTicket() {
        flag = true;

        if ($.trim($("#Ticket").val()) == "") {
            $("#Ticket").addClass("input-validation-error");
            flag = false;
        }
        else {
            $("#Ticket").removeClass("input-validation-error");
        }
        if (flag) {
            var obj = {
                TicketID: $("#Ticket").val(),
            };

            $.ajax({
                type: "POST",
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("CheckTicket", "Home", new { area = "" })',
                data: JSON.stringify(obj),
                dataType: "json",
                beforeSend: function () {
                    // setting a timeout
                    $('#btnserwait').show();
                    $('#btnser').hide();

                },
                success: function (resp) {
                    $('#Ticket').val("");
                    // alert(resp.data)
                    if (resp.data == "success") {
                        //  alert("/Home/Tickets/?Ticket=" + resp.res)
                        window.location.href = "/Home/Tickets/?Ticket=" + resp.res;

                    }
                    else {
                        Swal.fire(resp.data)

                    }
                },
                error: function (result) {
                    alert('Service call failed: ' + result.status + ' Type :' + result.statusText);
                },
                complete: function () {
                    setTimeout(function () {
                        $('#btnserwait').hide();
                        $('#btnser').show();

                    }, 0);
                },
            });

        };
    }

    function ChangeForIgrs() {

        if ($('#CTypeID option:selected').text() == 'IGRS') {
            $('#enroligrs').html("IGRS No.");
            $('#Enroll_Roll').attr("placeholder", "IGRS No.");
            $('.igrshide').hide();
            $('.duplhide').hide();
        }

        else if ($('#CTypeID option:selected').text() == 'TN-No') {
            $('#enroligrs').html("TN-No");
            $('#Enroll_Roll').attr("placeholder", "TN-No.");
            $('.igrshide').hide();
            $('.duplhide').hide();

        }
        else if ($('#CTypeID option:selected').text() == 'RTI') {
            $('#enroligrs').html("RTI");
            $('#Enroll_Roll').attr("placeholder", "RTI - No.");
            $('.igrshide').hide();
            $('.duplhide').hide();

        }
        else if ($('#CTypeID option:selected').text() == 'Computerized/Duplicate Marksheet') {

            $('.duplhide').show();


        }
        else {
            $('#enroligrs').html("Roll/Enrollment");
            $('.igrshide').show();
            $('.duplhide').hide();
        }

    }
</script>
