                                                    <a class="btn btn-warning" href="/">Back</a>

                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    function Ticketsave() {
        flag = true;

        if ($.trim($("#Message").val()) == "") {
            $("trix-editor").addClass("input-validation-error");
            flag = false;

        }
        else {
            $("trix-editor").addClass("input-validation-error");
        }

        if (flag) {
            $("#help").submit();
        }

    }


       //----------------------------
         var dt = new DataTransfer();

      $("#attachment").on("change", function () {

          var input = this;
          var selectedFiles = Array.from(input.files);

          selectedFiles.forEach(function (file) {

              var fileName = file.name;
              var fileSize = file.size;
              var fileExt = fileName.split(".").pop().toLowerCase();

              var allowedExt = ["jpg", "jpeg", "png", "pdf"];
              var maxSize = 1 * 1024 * 1024; // 1 MB

              // Extension validation
              if ($.inArray(fileExt, allowedExt) === -1) {
                  alert("File (" + fileName + ") type is not allowed.");
                  return; // IMPORTANT - don't add
              }

              // Size validation
              if (fileSize > maxSize) {
                  alert("File (" + fileName + ") size is too big. Max 1 MB.");
                  return; // IMPORTANT - don't add
              }

              // Duplicate check
              var alreadyExists = false;

              for (var j = 0; j < dt.files.length; j++) {
                  if (
                      dt.files[j].name === file.name &&
                      dt.files[j].size === file.size
                  ) {
                      alreadyExists = true;
                      break;
                  }
              }

              if (alreadyExists) {
                  alert("File (" + fileName + ") already selected.");
                  return;
              }

              // Add ONLY valid file
              dt.items.add(file);

              // Display file
              var fileBloc = $("<span/>", {
                  class: "file-block"
              });

              var fileNameSpan = $("<span/>", {
                  class: "name",
                  text: fileName
              });

              fileBloc
                  .append('<span class="file-delete"><span>+</span></span>')
                  .append(fileNameSpan);

              $("#filesList > #files-names").append(fileBloc);
          });

          // VERY IMPORTANT
          // Replace input files with ONLY valid files
          input.files = dt.files;
      });


      // Remove file
      $(document).on("click", ".file-delete", function () {

          var fileBlock = $(this).closest(".file-block");
          var fileName = fileBlock.find(".name").text();

          // Remove UI
          fileBlock.remove();

          // Remove from DataTransfer
          for (var i = 0; i < dt.items.length; i++) {

              var file = dt.items[i].getAsFile();

              if (file && file.name === fileName) {
                  dt.items.remove(i);
                  break;
              }
          }

          // Update actual input
          document.getElementById("attachment").files = dt.files;
      });
    // ----------------------------
</script>
<style>
    #files-area {
        /* width: 30%; */
        margin: 0 auto;
    }

    .file-block {
        border-radius: 10px;
        background-color: rgba(144, 163, 203, 0.2);
        margin: 5px;
        color: initial;
        display: inline-flex;
        padding-right: 10px;
        width: max-content;
        display: inline-flex;
    }

        .file-block > span.name {
            padding-right: 10px;
            width: max-content;
            display: inline-flex;
        }

    .file-delete {
        display: flex;
        width: 24px;
        color: initial;
        background-color: #6eb4ff00;
        font-size: large;
        justify-content: center;
        margin-right: 3px;
        cursor: pointer;
    }

        .file-delete:hover {
            background-color: rgba(144, 163, 203, 0.2);
            border-radius: 10px;
        }

        .file-delete span {
            transform: rotate(45deg);
        }



    .glow {
        animation: example 2s linear infinite;
    }

    @@keyframes example {
        from {
            color: white;
        }

        to {
            color: #ccc;
        }
    }

    .newsline {
        font-family: sans-serif;
        /*  margin: 100px auto;*/
        color: #228B22;
        text-align: center;
        position: relative;
    }

        .newsline:before {
            content: "";
            display: block;
            width: 30px;
            height: 5px;
            background: white;
            left: 0;
            top: 50%;
            position: absolute;
        }

        .newsline:after {
            content: "";
            display: block;
            width: 30px;
            height: 5px;
            background: white;
            right: 0;
            top: 50%;
            position: absolute;
        }

    .select2-container .select2-selection--single {
        height: 40px;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 40px;
    }
</style>